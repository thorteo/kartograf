{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "linux-dev",
      "displayName": "Linux core + tests",
      "description": "Portable core only. No Windows headers involved.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "TARKOV_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "linux-tsan",
      "inherits": "linux-dev",
      "displayName": "Linux core + ThreadSanitizer",
      "description": "See docs/adr/0004-threading-model.md",
      "binaryDir": "${sourceDir}/build/linux-tsan",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=thread,undefined -fno-omit-frame-pointer -g"
      }
    },
    {
      "name": "linux-asan",
      "inherits": "linux-dev",
      "displayName": "Linux core + Address/UB sanitizer",
      "binaryDir": "${sourceDir}/build/linux-asan",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -g"
      }
    },
    {
      "name": "windows-dev",
      "displayName": "Windows overlay (cross-compiled from Linux)",
      "description": "clang-cl against the real MSVC CRT and Windows SDK fetched by xwin",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-dev",
      "toolchainFile": "${sourceDir}/cmake/windows-clang-cl.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "TARKOV_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "linux-release",
      "inherits": "linux-dev",
      "displayName": "Linux core + tests, optimised",
      "binaryDir": "${sourceDir}/build/linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-dev",
      "configurePreset": "linux-dev"
    },
    {
      "name": "linux-tsan",
      "configurePreset": "linux-tsan"
    },
    {
      "name": "linux-asan",
      "configurePreset": "linux-asan"
    },
    {
      "name": "windows-dev",
      "configurePreset": "windows-dev"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    }
  ],
  "testPresets": [
    {
      "name": "linux-dev",
      "configurePreset": "linux-dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-asan",
      "configurePreset": "linux-asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
