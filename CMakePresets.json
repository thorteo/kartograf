{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
  "configurePresets": [
    {
      "name": "linux-dev",
      "displayName": "Linux core + tests",
      "description": "Portable core only. No Windows headers involved.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "TARKOV_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "linux-tsan",
      "inherits": "linux-dev",
      "displayName": "Linux core + ThreadSanitizer",
      "description": "See docs/adr/0004-threading-model.md",
      "binaryDir": "${sourceDir}/build/linux-tsan",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=thread,undefined -fno-omit-frame-pointer -g"
      }
    },
    {
      "name": "linux-asan",
      "inherits": "linux-dev",
      "displayName": "Linux core + Address/UB sanitizer",
      "binaryDir": "${sourceDir}/build/linux-asan",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -g"
      }
    }
  ],
  "buildPresets": [
    { "name": "linux-dev",  "configurePreset": "linux-dev" },
    { "name": "linux-tsan", "configurePreset": "linux-tsan" },
    { "name": "linux-asan", "configurePreset": "linux-asan" }
  ],
  "testPresets": [
    {
      "name": "linux-dev",
      "configurePreset": "linux-dev",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-asan",
      "configurePreset": "linux-asan",
      "output": { "outputOnFailure": true }
    }
  ]
}
