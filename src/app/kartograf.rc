// Windows resources compiled into the overlay exe.
#include "platform/win32/Resources.h"
#include "app/Version.h"

// Regenerate from icon/*.svg with scripts/make_icon.py.
TARKOV_IDI_APP ICON "icon/kartograf.ico"

// What Explorer shows under Properties > Details. Numbers rather than
// winver.h's names: 0x40004 is VOS_NT_WINDOWS32, 0x1 VFT_APP.
1 VERSIONINFO
FILEVERSION KARTOGRAF_VERSION_MAJOR, KARTOGRAF_VERSION_MINOR, KARTOGRAF_VERSION_PATCH, 0
PRODUCTVERSION KARTOGRAF_VERSION_MAJOR, KARTOGRAF_VERSION_MINOR, KARTOGRAF_VERSION_PATCH, 0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "thorteo"
            VALUE "FileDescription", "Kartograf: map and quest overlay for Escape from Tarkov"
            VALUE "FileVersion", KARTOGRAF_VERSION_STRING
            VALUE "InternalName", "kartograf"
            VALUE "LegalCopyright", "Copyright (c) 2026 thorteo. MIT License."
            VALUE "OriginalFilename", "kartograf.exe"
            VALUE "ProductName", "Kartograf"
            VALUE "ProductVersion", KARTOGRAF_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
